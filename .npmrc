# The public registry, explicitly.
#
# Without this the lockfile records whatever registry the machine happens to be
# configured with — a corporate mirror, in the case of the machine this was
# written on — and every `resolved` URL points at a host that exists on one
# network and nowhere else. Continuous integration then installs nothing and
# fails on the first command that needed a dependency.
#
# A published lockfile is a promise about where the code comes from. It should
# name a registry anyone can reach.
registry=https://registry.npmjs.org/
